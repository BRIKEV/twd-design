# TWD Design configuration. Full reference: https://design.twd.dev/docs/reference/configuration

# --- Slack (required) ---------------------------------------------------------
# Bot User OAuth Token, from your Slack app > OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token with connections:write, from Basic Information > App-Level Tokens.
# Set it to use Socket Mode (no public URL needed). Leave it empty to receive events over HTTP.
SLACK_APP_TOKEN=xapp-...
# Basic Information > App Credentials. Required in HTTP mode.
SLACK_SIGNING_SECRET=

# --- Model (required) ---------------------------------------------------------
# Any Mastra model router id: zai/glm-5.3-flash, anthropic/<model>, openai/<model>, deepseek/<model>...
MODEL=zai/glm-5.3-flash
# The API key variable of the provider in MODEL (zai → ZHIPU_API_KEY, anthropic → ANTHROPIC_API_KEY, ...).
ZHIPU_API_KEY=
# GLM thinking is off by default (faster, fewer tokens). Set to "on" to enable it.
# THINKING=on
# Thinking only for the plan (scenarios + page contract), not for writing the page:
# PLAN_THINKING=on

# --- GitHub (optional: design guide and pull requests) ------------------------
GITHUB_APP_ID=
# The .pem contents. One line is fine.
GITHUB_PRIVATE_KEY=

# --- Runtime (optional) -------------------------------------------------------
# PORT=3000                  # /healthz, plus Slack events in HTTP mode
# LOG_LEVEL=info             # debug | info | warn | error
# MAX_TURNS_PER_THREAD=15
# SHUTDOWN_TIMEOUT_MS=60000  # on SIGTERM, wait this long for running turns
